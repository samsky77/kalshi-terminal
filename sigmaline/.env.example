# ── Database (Supabase) ── server-only; never expose the service role key to the browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Optional alternative to Supabase for the worker / tests: any Postgres URL
# DATABASE_URL=

# ── Whop (payments + sign-in) ──
WHOP_API_KEY=
WHOP_CLIENT_ID=
WHOP_CLIENT_SECRET=
WHOP_WEBHOOK_SECRET=
WHOP_PRODUCT_ID=
# Checkout link for the trial plan (7-day free trial, payment method collected up front)
NEXT_PUBLIC_WHOP_CHECKOUT_URL=
# Optional: same product without a trial, for accounts that already used theirs
NEXT_PUBLIC_WHOP_CHECKOUT_URL_NO_TRIAL=
# Monthly price shown after the trial (default 25)
NEXT_PUBLIC_PRICE_MONTHLY=25
# Public URL of the deployed app (used for the OAuth redirect: <APP_URL>/api/auth/callback)
APP_URL=http://localhost:3000
# 32+ random characters used to sign session cookies:  openssl rand -hex 32
SESSION_SECRET=

# ── Odds and stats providers ──
ODDS_API_KEY=
PROPLINE_API_KEY=
SHARPAPI_KEY=
# Off until SharpAPI confirms in writing that the free plan allows showing odds to paying users
SHARPAPI_ENABLED=false

# ── Feature flags ──
PROPS_NBA_ENABLED=false
PROPS_NFL_ENABLED=false
# template (default) | llm  — llm is a stub; it may only receive the structured facts
WRITEUP_PROVIDER=template

# ── Alerts ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Paid-members Discord channel webhook
DISCORD_WEBHOOK_URL=
# Private channel for job-failure alerts to you (optional; GitHub also emails on failed runs)
DISCORD_ERROR_WEBHOOK_URL=

# ── Scheduling ──
# Netlify only: fine-grained GitHub token (this repo, Actions read+write) so netlify/functions/kick-worker.mjs
# can start the worker every 15 minutes (GitHub's own schedule is unreliable)
GH_DISPATCH_TOKEN=

# ── Admin ──
ADMIN_EMAIL=you@example.com
